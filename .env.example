# Notion Task Tracker CLI - Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# Your Notion Integration API Key
# Get it from: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Notion Database ID
# Find it in your database URL: https://notion.so/workspace/{database_id}?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Set different database IDs for different environments
# NOTION_DATABASE_ID_DEV=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID_STAGING=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID_PROD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
