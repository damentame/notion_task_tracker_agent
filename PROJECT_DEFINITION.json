  "technology_stack": {
    "runtime": "node.js",
    "language": "javascript_es_modules",
    "primary_dependencies": [
      "@notionhq/client@^5.1.0",
      "dotenv@^17.2.3"
    ],
    "required_environment_variables": [
      "NOTION_API_KEY",
      "NOTION_DATABASE_ID"
    ]
  },
  "api_surface": {
    "exported_functions": [
      {
        "name": "createTask",
        "parameters": ["title", "assignedTo", "notes"],
        "return_type": "Promise<string>",
        "description": "Creates a new task in Notion database"
      },
      {
        "name": "updateTask",
        "parameters": ["pageId", "status", "notes"],
        "return_type": "Promise<void>",
        "description": "Updates task status and notes"
      }
    ]
  },
  "notion_schema": {
    "database_properties": {
      "Task": {
        "type": "title",
        "description": "Task title/name"
      },
      "Assigned To": {
        "type": "people",
        "description": "Person assigned to task"
      },
      "Status": {
        "type": "status",
        "description": "Task status",
        "expected_values": ["To-do", "Done", "In Progress"]
      },
      "Notes": {
        "type": "rich_text",
        "description": "Additional task notes"
      },
      "ID": {
        "type": "number",
        "description": "Auto-incremented task identifier"
      }
    }
  },
