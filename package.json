{
  "name": "notion-task-manager",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix"
  },
  "keywords": [
    "notion",
    "task-manager",
    "cli",
    "productivity"
  ],
  "author": "",
  "license": "ISC",
  "description": "A CLI tool for managing tasks in Notion",
  "dependencies": {
    "@notionhq/client": "^5.1.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  }
}
